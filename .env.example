# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Comma-separated Telegram user IDs allowed to run /deploy.
# Leave empty during local testing, but ALWAYS set this in production.
# Get your own ID by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=111111111,222222222

# The shell command that performs your deploy.
# Examples:
#   DEPLOY_COMMAND=bash ./deploy.sh
#   DEPLOY_COMMAND=git pull && npm ci && pm2 restart app
DEPLOY_COMMAND=echo "Replace DEPLOY_COMMAND in .env with your real deploy script"

# Working directory the deploy command should run from
DEPLOY_CWD=.

# Max time (ms) to let the deploy command run before killing it
DEPLOY_TIMEOUT_MS=120000

# Set to true to use webhook mode instead of polling.
USE_WEBHOOK=false

# Public URL for Telegram to call when webhook mode is enabled.
# Example: https://your-domain.example.com/telegram
WEBHOOK_URL=

# Path Telegram should call on your webhook server.
WEBHOOK_PATH=/telegram

# Port the local webhook server should listen on.
WEBHOOK_PORT=3000

# Optional shared secret for Telegram webhook validation.
WEBHOOK_SECRET_TOKEN=
